{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remixer Tools",
  "version": "1.0.0",
  "identifier": "com.armzi.remixer-tools",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Remixer Tools",
        "width": 1024,
        "height": 600,
        "minWidth": 1024,
        "minHeight": 600,
        "maximizable": true,
        "fullscreen": false,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/neondeveloperz/remixer-tools/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0NDZDRDAyRUY4QjlDRjIKUldUeW5JdnZBczFHbE5RQVFrcnRab3ZsY0JnQ2xPeGYyc1lIYkhTWGYrUWFkcUtjT0pIaFZuYVcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/yt-dlp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}