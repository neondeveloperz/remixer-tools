{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remixer Tools",
  "version": "0.2.0",
  "identifier": "com.armzi.remixer-tools",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Remixer Tools",
        "width": 1024,
        "height": 600,
        "minWidth": 1024,
        "minHeight": 600,
        "maxWidth": 1024,
        "maxHeight": 600,
        "maximizable": false,
        "fullscreen": false,
        "resizable": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/yt-dlp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
